# نمونه‌ی متغیرهای محیطی برای VPS — این فایل را به .env کپی و مقادیر را عوض کنید.
DJANGO_SECRET_KEY=یک-کلید-تصادفی-حداقل-۵۰-کاراکتری-اینجا
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=shop.example.com,www.shop.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://shop.example.com,https://www.shop.example.com
# اگر پشت Nginx با HTTPS هستید 1 بگذارید؛ برای تست HTTP موقتاً 0.
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_DB_PATH=/var/lib/hesabeshkon/db.sqlite3
ACCOUNTANT_DB_PATH=/var/lib/hesabeshkon/accountant.sqlite3
# ایمیل (اختیاری)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=shop@example.com

# خواندن فاکتور با مدل بینایی (اختیاری — بدون این‌ها Tesseract استفاده می‌شود)
# هر سرویس سازگار با OpenAI کار می‌کند: OpenAI، OpenRouter، vLLM، Ollama، LM Studio
# OCR_VISION_BASE_URL=https://api.openai.com/v1
# OCR_VISION_API_KEY=sk-...
# OCR_VISION_MODEL=gpt-4o-mini

